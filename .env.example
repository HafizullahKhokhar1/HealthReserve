# ===== HEALTHRESERVE ENVIRONMENT VARIABLES =====
# Copy this file to .env and fill in your credentials

# ===== Firebase Configuration =====
# Already configured in firebase-applet-config.json
# Uses the HealthReserve01 Firebase project

# ===== Google Gemini AI (Optional but Recommended) =====
# Get free API key from: https://aistudio.google.com/app/apikey
# This enables the Floating AI Assistant and doctor profile AI features

# Your Google Gemini API Key (https://aistudio.google.com/app/apikey)
# WARNING: This is exposed in the browser (client-side key)
# For production, implement server-side key management
VITE_GEMINI_API_KEY=AIzaSyDsl2FpmQ3hUEjY19rWn2EwcH_rA8E3GfI

# Gemini model version (optional, defaults to gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
VITE_GEMINI_MODEL=gemini-1.5-flash

# ===== Twilio WhatsApp Notifications (Optional) =====
# Required for appointment reminders and status updates
# Get credentials from: https://www.twilio.com/whatsapp
# Note: These are configured via Firebase Cloud Functions, not here

# Your Twilio Account SID (found in console.twilio.com)
# Set via: firebase functions:config:set twilio.sid="ACxxxxxxxx"
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token (found in console.twilio.com)
# Set via: firebase functions:config:set twilio.token="your_token"
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your WhatsApp Sandbox Number (from Twilio Dashboard)
# Format: +1234567890
# Set via: firebase functions:config:set twilio.from="+1234567890"
TWILIO_WHATSAPP_FROM=+1234567890

# ===== How to Use =====
# 1. Copy this file: cp .env.example .env
# 2. Fill in VITE_GEMINI_API_KEY with your key from https://aistudio.google.com/app/apikey
# 3. Restart dev server: npm run dev
# 4. Test the floating AI assistant in the bottom-right corner
# 
# For Firebase deployment:
# 1. Keep .env in your project (it will be bundled into the app)
# 2. Or set environment variables in your build environment
# 3. Deploy: npm run build && firebase deploy --only hosting

# ===== Optional: Email Notifications =====
# For SendGrid email integration (future use)
# VITE_SENDGRID_API_KEY=SG.xxxxxxxxxxxx

# ===== Optional: Gemini Recommendation AI =====
# Put your Gemini API key here if you want AI ranking in the app.
# This is a client-side Vite env var, so it becomes public in the built app.
# Leave blank to use the free local ranking fallback.
# VITE_GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx
# VITE_GEMINI_MODEL=gemini-1.5-flash

# ===== Environment =====
VITE_ENVIRONMENT=development

